<Window x:Class="MyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyApp" Width="920" Height="760" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource ToolWindow}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <!-- Right-click anywhere on the window: appearance is always reachable. -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Appearance">
                <MenuItem x:Name="MenuModern" Header="Modern" Click="MenuModern_Click"/>
                <MenuItem x:Name="MenuWin95" Header="Windows 95" Click="MenuWin95_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="About MyApp" Click="About_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title, version badge, Main menu button on the right. -->
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="&#x2190; Main menu" Style="{StaticResource SmallButton}" IsEnabled="False"
                    ToolTip="Tool windows opened from a launcher return to it here. Disabled while busy."/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MyApp" Style="{StaticResource WindowTitle}"/>
                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource Badge.Pre.Background}">
                    <TextBlock x:Name="VersionBadge" Text="v0.1.0" Foreground="{DynamicResource Badge.Pre.Foreground}" FontSize="11"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Inputs card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Inputs" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Drop a folder anywhere on the window, or onto the exe in Explorer. Right-click a path for more."/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Input folder" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="InputBox" Grid.Column="1" Style="{StaticResource PathBox}">
                                <TextBox.ContextMenu>
                                    <ContextMenu Opened="InputMenu_Opened">
                                        <MenuItem Header="Browse…" Click="Browse_Click"/>
                                        <MenuItem Header="Open in Explorer" Click="OpenFolder_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="RecentMenu" Header="Recent"/>
                                        <Separator/>
                                        <MenuItem Header="Clear" Click="ClearInput_Click"/>
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                            <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Browse_Click"/>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="OpenWhenDone" Content="Open the result when done" Style="{StaticResource OptionCheckBox}" Margin="0,4,24,4"/>
                            <TextBlock Text="Style:" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="ModernRadio" GroupName="Style" Content="Modern" Style="{StaticResource OptionRadio}" Checked="Style_Changed"/>
                            <RadioButton x:Name="Win95Radio" GroupName="Style" Content="Windows 95" Style="{StaticResource OptionRadio}" Checked="Style_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Before-you-go checklist: one row per input, marked ✔ ! ✖ – -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Before you go" Style="{StaticResource SubHeader}"/>
                        <TextBlock Style="{StaticResource HintText}" Text="Right-click a row for its fix."/>
                        <StackPanel x:Name="Checklist" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Actions: one primary (default) button per window, secondary for the rest. -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="RunButton" Content="Run" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="Run_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Run" InputGestureText="Ctrl+R" Click="Run_Click"/>
                                <MenuItem Header="Copy command line" Click="CopyCommand_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Cancel" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" MinWidth="90" Click="Cancel_Click"/>
                    <Button Content="Copy command line" Margin="8,0,0,0" Style="{StaticResource SmallButton}" VerticalAlignment="Center" Click="CopyCommand_Click"/>
                </StackPanel>

                <!-- Output pane -->
                <Border Style="{StaticResource SectionBox}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Output" Style="{StaticResource SubHeader}" Margin="0,0,0,8"/>
                        <RichTextBox x:Name="Log" Style="{StaticResource LogBox}" Height="170" FontFamily="{DynamicResource Font.Mono}" FontSize="12">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy all" Click="CopyLog_Click"/>
                                    <MenuItem Header="Clear" Click="ClearLog_Click"/>
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                            <FlowDocument x:Name="LogDoc" PagePadding="0"/>
                        </RichTextBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status strip: result badge, message, busy bar. Pulses while waiting for the user. -->
        <Border x:Name="Status" Grid.Row="2" Style="{StaticResource StatusStrip}" Margin="0,14,0,0">
            <DockPanel>
                <Border x:Name="ResultBadge" DockPanel.Dock="Left" Style="{StaticResource Badge}" Background="{DynamicResource Badge.Neutral.Background}">
                    <TextBlock x:Name="ResultText" Text="Ready" Foreground="{DynamicResource Badge.Neutral.Foreground}" FontSize="11"/>
                </Border>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Style="{StaticResource BusyBar}" Width="160" Visibility="Collapsed" IsIndeterminate="True"/>
                <TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Text}" Text="Pick an input folder and press Run."/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="Footer" Grid.Row="3" Style="{StaticResource FooterText}" Margin="2,8,0,0"
                   Text="MyApp · right-click anywhere for appearance"/>
    </Grid>
</Window>
